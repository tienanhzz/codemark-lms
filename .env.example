# Reference only: Spring reads OS environment variables, not this file automatically.
# PowerShell example: $env:PORT="5000"
PORT=5000
JDBC_DATABASE_URL=jdbc:h2:file:./instance/classflow;DB_CLOSE_ON_EXIT=FALSE
DB_USER=sa
DB_PASSWORD=
# MariaDB alternative: jdbc:mariadb://localhost:3306/classflow
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Set true for HTTPS.
COOKIE_SECURE=false
UPLOAD_DIR=./instance/uploads
# Base64url of 32 random bytes; blank creates a persistent demo key in instance/.
TOKEN_ENCRYPTION_KEY=
CODE_RUNNER_ENABLED=false
CODE_RUNNER_IMAGE=codemark-classflow-runner:latest
CODE_RUNNER_MAX_CONCURRENCY=2
# Optional frontend overrides belong in frontend/.env.local.
# NEXT_PUBLIC_API_URL=http://server-ip:5000
# NEXT_PUBLIC_SOCKET_URL=http://server-ip:5000
