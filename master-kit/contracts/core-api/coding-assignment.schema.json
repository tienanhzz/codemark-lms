{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://master-kit.local/contracts/coding-assignment.schema.json",
  "title": "Coding Assignment Question Selection",
  "description": "Published assignments retain the resolved question IDs as an immutable selection snapshot.",
  "type": "object",
  "required": ["assignmentId", "title", "selection", "questionIds"],
  "properties": {
    "assignmentId": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "selection": {
      "oneOf": [
        {
          "$ref": "#/$defs/manualSelection"
        },
        {
          "$ref": "#/$defs/tagSelection"
        }
      ]
    },
    "questionIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "manualSelection": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": {
          "const": "manual"
        }
      },
      "additionalProperties": false
    },
    "tagSelection": {
      "type": "object",
      "required": ["mode", "tagIds", "match"],
      "properties": {
        "mode": {
          "const": "tags"
        },
        "tagIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          }
        },
        "match": {
          "enum": ["any", "all"]
        }
      },
      "additionalProperties": false
    }
  }
}
