{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://master-kit.local/contracts/learning-taxonomy.schema.json",
  "title": "Learning Content Tag Taxonomy",
  "type": "object",
  "required": ["catalogVersion", "tags"],
  "properties": {
    "catalogVersion": {
      "type": "integer",
      "minimum": 1
    },
    "tags": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/tag"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "tag": {
      "type": "object",
      "required": ["id", "name", "parentId", "appliesTo", "assignable", "status", "sortOrder"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "name": {
          "$ref": "#/$defs/localizedName"
        },
        "parentId": {
          "type": ["string", "null"],
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "appliesTo": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["lesson", "codingQuestion"]
          }
        },
        "assignable": {
          "type": "boolean"
        },
        "status": {
          "enum": ["active", "retired"]
        },
        "sortOrder": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "localizedName": {
      "type": "object",
      "required": ["en", "vi"],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        },
        "vi": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
