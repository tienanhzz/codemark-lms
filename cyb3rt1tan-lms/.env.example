DATABASE_URL=postgresql+psycopg://YOUR_DB_USER:YOUR_DB_PASSWORD@127.0.0.1:5432/codemark_lms
APP_ENV=local
# Production only: distinct migrator login, same database, verify-full TLS + CA on both URLs.
MIGRATION_DATABASE_URL=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=10
DB_STATEMENT_TIMEOUT_MS=15000
DB_LOCK_TIMEOUT_MS=5000
TEST_DATABASE_URL=postgresql+psycopg://YOUR_DB_USER:YOUR_DB_PASSWORD@127.0.0.1:5432/codemark_lms_test
LOGIN_HMAC_KEY=GENERATE_A_RANDOM_VALUE_OF_AT_LEAST_32_CHARACTERS
MFA_ENCRYPTION_KEY=GENERATE_BASE64_OF_32_RANDOM_BYTES
APP_ORIGIN=http://127.0.0.1:3100
COOKIE_SECURE=false
NEXT_TELEMETRY_DISABLED=1

# Dormant BUILD-028 Redis Streams transport. Keep disabled unless a dedicated
# authenticated Redis ACL user and deployment policy are approved.
RUNNER_QUEUE_ENABLED=false
RUNNER_REDIS_URL=

# Only enable after the institution approves its self-hosted STARTTLS relay.
SMTP_APPROVED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_CA_FILE=
