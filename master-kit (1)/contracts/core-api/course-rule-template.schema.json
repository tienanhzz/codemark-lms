{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://master-kit.local/contracts/course-rule-template.schema.json",
  "title": "Shared Course Rules Template",
  "type": "object",
  "required": ["rules"],
  "properties": {
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/rule" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "rule": {
      "type": "object",
      "required": ["ruleId", "category", "title", "body", "position"],
      "properties": {
        "ruleId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "category": {
          "type": "string",
          "enum": [
            "attendance",
            "assignmentSubmission",
            "practice",
            "assessment",
            "classroomConduct",
            "communication",
            "other"
          ]
        },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "body": { "type": "string", "minLength": 1, "maxLength": 5000 },
        "position": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  }
}
